{
  "name": "vast-translator-chrome-plugin",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "e2e": "playwright test --grep-invert @network",
    "e2e:network": "playwright test tests/e2e/network.spec.ts",
    "e2e:switchyomega": "playwright test tests/e2e/network.spec.ts",
    "release:package": "python scripts/package-release.py",
    "release:validate": "node scripts/validate-release.mjs",
    "experts:sync": "python scripts/sync-experts.py",
    "experts:check": "python scripts/sync-experts.py --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/chrome": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "typescript": "latest",
    "vitest": "latest"
  }
}
